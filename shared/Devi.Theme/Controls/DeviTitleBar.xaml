<UserControl x:Class="Devi.Theme.Controls.DeviTitleBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
             Height="{StaticResource TitleBarHeight}"
             Focusable="False">
  <!-- The same title bar on every DEVI window: white wordmark, tool name, detail, caption buttons. -->
  <Border Background="{StaticResource CanvasBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="{StaticResource HairlineBottom}">
    <Grid>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
        <Image Source="pack://application:,,,/Devi.Theme;component/Assets/devi-wordmark-white.png" Height="14" Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" />
        <Border Width="1" Height="14" Margin="12,0" Background="{StaticResource LineBrush}" VerticalAlignment="Center" />
        <TextBlock x:Name="ToolNameText" VerticalAlignment="Center" FontFamily="{StaticResource SansFont}"
                   FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium" Foreground="{StaticResource TextBrush}" />
        <TextBlock x:Name="DetailText" Margin="10,1,0,0" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                   FontSize="{StaticResource FontSizeEyebrow}" Foreground="{StaticResource MutedBrush}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" shell:WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="MinimizeButton" Style="{StaticResource CaptionButton}" ToolTip="Minimize" AutomationProperties.Name="Minimize" Click="Minimize_Click">
          <Path Width="10" Height="10" Stretch="None" StrokeThickness="1" Data="{StaticResource IconCaptionMinimize}"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" ToolTip="Maximize" AutomationProperties.Name="Maximize" Click="Maximize_Click">
          <Path x:Name="MaximizeIcon" Width="10" Height="10" Stretch="None" StrokeThickness="1" Data="{StaticResource IconCaptionMaximize}"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
        <Button x:Name="CloseWindowButton" Style="{StaticResource CloseButton}" ToolTip="Close" AutomationProperties.Name="Close" Click="Close_Click">
          <Path Width="10" Height="10" Stretch="None" StrokeThickness="1" Data="{StaticResource IconCaptionClose}"
                Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</UserControl>
