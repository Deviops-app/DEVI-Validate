<?xml version="1.0" encoding="utf-8"?>
<!--
  DEVI color, spacing, and shape tokens for the Windows tools.

  This is the only file in the Windows tools that may contain a color literal.
  Every value mirrors a token on deviops.app. App XAML and C# take colors from here
  and never hold a color literal of their own.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

  <!-- Surfaces. Site: html/body #0A0A0B, panel #111113, panel-hover #151517. -->
  <Color x:Key="CanvasColor">#FF0A0A0B</Color>
  <Color x:Key="SurfaceColor">#FF0A0A0B</Color>
  <Color x:Key="CardColor">#FF111113</Color>
  <Color x:Key="CardAltColor">#FF151517</Color>
  <Color x:Key="InsetColor">#FF0D0D0F</Color>

  <!-- Hairlines. Site: hair rgba(255,255,255,.08), hair2 .14, field .38. -->
  <Color x:Key="BorderColor">#14FFFFFF</Color>
  <Color x:Key="LineColor">#24FFFFFF</Color>
  <Color x:Key="LineStrongColor">#47FFFFFF</Color>
  <Color x:Key="FieldBorderColor">#61FFFFFF</Color>

  <!-- Text. Site: text-primary #FFF, text-secondary #A1A1A8, text-muted #8F8F99. -->
  <Color x:Key="TextColor">#FFFFFFFF</Color>
  <Color x:Key="SecondaryColor">#FFA1A1A8</Color>
  <Color x:Key="MutedColor">#FF8F8F99</Color>
  <Color x:Key="FaintColor">#FF6E6E78</Color>

  <!-- Accent. Restrained: links, focus ring, selection, the active step. Site: accent #4B8DF8. -->
  <Color x:Key="AccentColor">#FF4B8DF8</Color>
  <Color x:Key="AccentHoverColor">#FF70A7FF</Color>
  <Color x:Key="AccentDeepColor">#FF1E4FC0</Color>
  <Color x:Key="AccentTextColor">#FF7FAEFA</Color>
  <Color x:Key="AccentInkColor">#FF081018</Color>
  <Color x:Key="AccentSoftColor">#1F4B8DF8</Color>
  <Color x:Key="SelectionColor">#334B8DF8</Color>
  <!-- Second stop of the site accent gradient (90deg, #4B8DF8 to #8B77EE). -->
  <Color x:Key="AccentPurpleColor">#FF8B77EE</Color>

  <!-- Primary action. Site .btn: #FAFAFA fill, #0A0A0B text, hover #E4E4E7. -->
  <Color x:Key="PrimaryFillColor">#FFFAFAFA</Color>
  <Color x:Key="PrimaryFillHoverColor">#FFE4E4E7</Color>
  <Color x:Key="PrimaryFillPressedColor">#FFD4D4D8</Color>
  <Color x:Key="PrimaryInkColor">#FF0A0A0B</Color>

  <!-- Status. Used for results only, never for decoration. -->
  <Color x:Key="SuccessColor">#FF34C87A</Color>
  <Color x:Key="SuccessInkColor">#FF062417</Color>
  <Color x:Key="SuccessSoftColor">#1F34C87A</Color>
  <Color x:Key="WarningColor">#FFF5A524</Color>
  <Color x:Key="WarningInkColor">#FF2A1804</Color>
  <Color x:Key="WarningSoftColor">#1FF5A524</Color>
  <Color x:Key="DangerColor">#FFF25F5C</Color>
  <Color x:Key="DangerInkColor">#FF2A0A0A</Color>
  <Color x:Key="DangerSoftColor">#1FF25F5C</Color>
  <Color x:Key="NeutralSoftColor">#0FFFFFFF</Color>

  <!-- Interaction fills. Site: ghost hover rgba(255,255,255,.05). -->
  <Color x:Key="ZoneHoverColor">#0DFFFFFF</Color>
  <Color x:Key="ZoneDragColor">#1F4B8DF8</Color>
  <Color x:Key="RowHoverColor">#0AFFFFFF</Color>
  <Color x:Key="ScrollThumbColor">#33FFFFFF</Color>
  <Color x:Key="ScrollThumbHoverColor">#59FFFFFF</Color>
  <Color x:Key="TooltipColor">#FF18181B</Color>
  <Color x:Key="ClearColor">#00000000</Color>

  <SolidColorBrush x:Key="CanvasBrush" Color="{StaticResource CanvasColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardColor}" />
  <SolidColorBrush x:Key="CardAltBrush" Color="{StaticResource CardAltColor}" />
  <SolidColorBrush x:Key="InsetBrush" Color="{StaticResource InsetColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}" />
  <SolidColorBrush x:Key="FieldBorderBrush" Color="{StaticResource FieldBorderColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource SecondaryColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentDeepBrush" Color="{StaticResource AccentDeepColor}" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentTextColor}" />
  <SolidColorBrush x:Key="AccentInkBrush" Color="{StaticResource AccentInkColor}" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoftColor}" />
  <SolidColorBrush x:Key="SelectionBrush" Color="{StaticResource SelectionColor}" />
  <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurpleColor}" />
  <!-- 2px focus border. Site: linear-gradient(90deg, accent blue, accent purple). -->
  <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
    <GradientStop Color="{StaticResource AccentColor}" Offset="0" />
    <GradientStop Color="{StaticResource AccentPurpleColor}" Offset="1" />
  </LinearGradientBrush>
  <SolidColorBrush x:Key="PrimaryFillBrush" Color="{StaticResource PrimaryFillColor}" />
  <SolidColorBrush x:Key="PrimaryFillHoverBrush" Color="{StaticResource PrimaryFillHoverColor}" />
  <SolidColorBrush x:Key="PrimaryFillPressedBrush" Color="{StaticResource PrimaryFillPressedColor}" />
  <SolidColorBrush x:Key="PrimaryInkBrush" Color="{StaticResource PrimaryInkColor}" />
  <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource SuccessColor}" />
  <SolidColorBrush x:Key="SuccessInkBrush" Color="{StaticResource SuccessInkColor}" />
  <SolidColorBrush x:Key="SuccessSoftBrush" Color="{StaticResource SuccessSoftColor}" />
  <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource WarningColor}" />
  <SolidColorBrush x:Key="WarningInkBrush" Color="{StaticResource WarningInkColor}" />
  <SolidColorBrush x:Key="WarningSoftBrush" Color="{StaticResource WarningSoftColor}" />
  <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource DangerColor}" />
  <SolidColorBrush x:Key="DangerInkBrush" Color="{StaticResource DangerInkColor}" />
  <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoftColor}" />
  <SolidColorBrush x:Key="NeutralSoftBrush" Color="{StaticResource NeutralSoftColor}" />
  <SolidColorBrush x:Key="ZoneHoverBrush" Color="{StaticResource ZoneHoverColor}" />
  <SolidColorBrush x:Key="ZoneDragBrush" Color="{StaticResource ZoneDragColor}" />
  <SolidColorBrush x:Key="RowHoverBrush" Color="{StaticResource RowHoverColor}" />
  <SolidColorBrush x:Key="ScrollThumbBrush" Color="{StaticResource ScrollThumbColor}" />
  <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="{StaticResource ScrollThumbHoverColor}" />
  <SolidColorBrush x:Key="TooltipBrush" Color="{StaticResource TooltipColor}" />
  <SolidColorBrush x:Key="ClearBrush" Color="{StaticResource ClearColor}" />

  <!-- Result chips (Validate counts, Decrypt facts, Registry status). -->
  <SolidColorBrush x:Key="ChipMatchBrush" Color="{StaticResource SuccessSoftColor}" />
  <SolidColorBrush x:Key="ChipMismatchBrush" Color="{StaticResource DangerSoftColor}" />
  <SolidColorBrush x:Key="ChipMissingBrush" Color="{StaticResource WarningSoftColor}" />
  <SolidColorBrush x:Key="ChipExtraBrush" Color="{StaticResource NeutralSoftColor}" />

  <!--
    Heading fill. Site: .hero h1 linear-gradient(180deg, #fff 35%, rgba(255,255,255,.55)).
    Used only on the page title of each window. Never on body text, never animated.
  -->
  <LinearGradientBrush x:Key="HeadingGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFFFF" Offset="0.35" />
    <GradientStop Color="#8CFFFFFF" Offset="1" />
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="SectionGradientBrush" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFFFF" Offset="0.2" />
    <GradientStop Color="#9EFFFFFF" Offset="1" />
  </LinearGradientBrush>

  <!-- Shape. Site: buttons and fields 8px, cards 12px, code 5px. -->
  <CornerRadius x:Key="RadiusControl">8</CornerRadius>
  <!--
    Field focus ring. The outer corner is RadiusControl (8). Idle is a 1px ring, so the
    inner corner is 7. Focus is the site's 2px ring, so the inner corner is 6. Keep each
    pair concentric: inner radius = outer radius minus thickness.
  -->
  <Thickness x:Key="FieldRingIdle">1</Thickness>
  <Thickness x:Key="FieldRingFocus">2</Thickness>
  <CornerRadius x:Key="RadiusFieldIdleInner">7</CornerRadius>
  <CornerRadius x:Key="RadiusFieldFocusInner">6</CornerRadius>
  <CornerRadius x:Key="RadiusCard">12</CornerRadius>
  <CornerRadius x:Key="RadiusChip">6</CornerRadius>
  <CornerRadius x:Key="RadiusPill">10</CornerRadius>
  <CornerRadius x:Key="RadiusNone">0</CornerRadius>
  <sys:Double x:Key="RadiusControlValue">8</sys:Double>

  <!-- Spacing. One 4px grid. -->
  <sys:Double x:Key="Space1">4</sys:Double>
  <sys:Double x:Key="Space2">8</sys:Double>
  <sys:Double x:Key="Space3">12</sys:Double>
  <sys:Double x:Key="Space4">16</sys:Double>
  <sys:Double x:Key="Space5">24</sys:Double>
  <sys:Double x:Key="Space6">32</sys:Double>
  <Thickness x:Key="PagePadding">24,20,24,16</Thickness>
  <Thickness x:Key="DialogPadding">24,20,24,24</Thickness>
  <Thickness x:Key="CardPadding">16,14,16,14</Thickness>
  <Thickness x:Key="CardPaddingCompact">14,10,14,10</Thickness>
  <Thickness x:Key="SectionGap">0,0,0,12</Thickness>
  <Thickness x:Key="HairlineBottom">0,0,0,1</Thickness>
  <Thickness x:Key="HairlineTop">0,1,0,0</Thickness>
  <Thickness x:Key="Hairline">1</Thickness>

  <!-- Window chrome sizes. The caption height must match WindowChrome.CaptionHeight. -->
  <sys:Double x:Key="TitleBarHeight">44</sys:Double>
  <sys:Double x:Key="StatusBarHeight">32</sys:Double>
  <sys:Double x:Key="ControlHeight">36</sys:Double>
  <sys:Double x:Key="ControlHeightCompact">28</sys:Double>
</ResourceDictionary>
