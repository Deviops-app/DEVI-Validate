  <!--
    Collapsible section with an obvious toggle: the whole header row is the click target, with a
    hover fill, a hand cursor, a focus ring, and a Show/Hide button with a chevron on the right.
    Opt in with Style="{StaticResource SectionExpander}"; the implicit Expander style is unchanged.
  -->
  <Style x:Key="SectionExpander" TargetType="{x:Type Expander}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Expander}">
          <Border BorderThickness="1" CornerRadius="{StaticResource RadiusCard}" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}">
            <DockPanel>
              <ToggleButton Name="HeaderSite" DockPanel.Dock="Top" Cursor="Hand" Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" FocusVisualStyle="{StaticResource FocusVisual}" AutomationProperties.Name="{TemplateBinding AutomationProperties.Name}" IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                <Control.Template>
                  <ControlTemplate TargetType="{x:Type ToggleButton}">
                    <Border Name="Row" Background="{StaticResource ClearBrush}" CornerRadius="12" Padding="16,10,12,10">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter VerticalAlignment="Center" />
                        <Border Name="Pill" Grid.Column="1" Margin="12,0,0,0" Padding="10,4,8,4" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{StaticResource LineBrush}" CornerRadius="{StaticResource RadiusControl}">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Name="PillText" Text="Show" VerticalAlignment="Center" FontSize="{StaticResource FontSizeSmall}" FontWeight="Medium" Foreground="{StaticResource SecondaryBrush}" />
                            <Path Name="Chevron" Margin="6,0,0,0" Width="12" Height="12" Style="{StaticResource LineIcon}" Data="{StaticResource IconChevronDown}" Stroke="{StaticResource SecondaryBrush}" RenderTransformOrigin="0.5,0.5" />
                          </StackPanel>
                        </Border>
                      </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsChecked" Value="True">
                        <Setter TargetName="PillText" Property="Text" Value="Hide" />
                        <Setter TargetName="Row" Property="CornerRadius" Value="12,12,0,0" />
                        <Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180" /></Setter.Value></Setter>
                      </Trigger>
                      <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource RowHoverBrush}" />
                        <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource LineStrongBrush}" />
                        <Setter TargetName="PillText" Property="Foreground" Value="{StaticResource TextBrush}" />
                        <Setter TargetName="Chevron" Property="Stroke" Value="{StaticResource TextBrush}" />
                      </Trigger>
                      <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Pill" Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                      </Trigger>
                      <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{StaticResource CardAltBrush}" />
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Control.Template>
              </ToggleButton>
              <Border Name="Divider" DockPanel.Dock="Top" Height="1" Background="{StaticResource BorderBrush}" Visibility="Collapsed" />
              <ContentPresenter Name="ExpandSite" DockPanel.Dock="Bottom" Margin="16,14,16,16" Visibility="Collapsed" />
            </DockPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="True">
              <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
              <Setter TargetName="Divider" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Editable drop-down: pick from the list or type a value. Tag is the hint shown while empty. -->
  <Style x:Key="EditableComboBox" TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
    <Setter Property="IsEditable" Value="True" />
    <Setter Property="IsTextSearchEnabled" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ComboBox}">
          <Grid>
            <controls:FieldRing IsActive="{TemplateBinding IsKeyboardFocusWithin}" Background="{TemplateBinding Background}">
              <Grid>
                <TextBox Name="PART_EditableTextBox" MinHeight="0" Padding="0" BorderThickness="0" FocusVisualStyle="{x:Null}" Background="{StaticResource ClearBrush}" Margin="0,0,32,0" VerticalAlignment="Stretch" VerticalContentAlignment="Center" Foreground="{StaticResource TextBrush}" CaretBrush="{StaticResource TextBrush}" SelectionBrush="{StaticResource SelectionBrush}" IsReadOnly="{TemplateBinding IsReadOnly}" FontSize="{TemplateBinding FontSize}">
                  <TextBox.Template>
                    <ControlTemplate TargetType="{x:Type TextBox}">
                      <Grid Background="{StaticResource ClearBrush}">
                        <ScrollViewer Name="PART_ContentHost" Margin="10,0,0,0" VerticalAlignment="Center" Focusable="False" />
                        <TextBlock Name="Hint" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=ComboBox}}" Margin="14,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                      </Grid>
                      <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                          <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </TextBox.Template>
                </TextBox>
                <ToggleButton Name="Toggle" Width="32" HorizontalAlignment="Right" Focusable="False" ClickMode="Press" Cursor="Hand" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                  <Control.Template>
                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                      <Border Background="{StaticResource ClearBrush}">
                        <Path Width="8" Height="5" Stretch="Fill" Data="M0,0 L4,4 L8,0" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Stroke="{StaticResource SecondaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                      </Border>
                    </ControlTemplate>
                  </Control.Template>
                </ToggleButton>
              </Grid>
            </controls:FieldRing>
            <Popup Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade" IsOpen="{TemplateBinding IsDropDownOpen}">
              <Border BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="4" Margin="0,4,0,0" Background="{StaticResource CardBrush}" BorderBrush="{StaticResource LineBrush}" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                <ScrollViewer MaxHeight="320" CanContentScroll="True">
                  <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Required field marker and inline field message. -->
  <Style x:Key="RequiredMark" TargetType="TextBlock">
    <Setter Property="Text" Value="Required" />
    <Setter Property="Margin" Value="6,0,0,6" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeEyebrow}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource WarningBrush}" />
    <Setter Property="VerticalAlignment" Value="Bottom" />
  </Style>
  <Style x:Key="FieldError" TargetType="TextBlock">
    <Setter Property="Margin" Value="0,6,0,0" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Visibility" Value="Collapsed" />
  </Style>

  <!-- Settings dialog shell: the same sections and spacing in every DEVI app. -->
  <Style x:Key="Settings.Section" TargetType="Border">
    <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
    <Setter Property="Padding" Value="0,0,0,20" />
    <Setter Property="Margin" Value="0,0,0,20" />
  </Style>
  <Style x:Key="Settings.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Heading}">
    <Setter Property="Margin" Value="0,0,0,4" />
  </Style>
  <Style x:Key="Settings.SectionNote" TargetType="TextBlock">
    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,0,0,14" />
  </Style>
  <Style x:Key="StepCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="Padding" Value="{StaticResource CardPaddingCompact}" />
  </Style>
  <!-- Verdict and notice band: a card with a 2px left rule in the status color (site .callout). -->
  <Style x:Key="CalloutCard" TargetType="Border" BasedOn="{StaticResource Card}">
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="3,1,1,1" />
  </Style>
  <Style x:Key="InsetBox" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource InsetBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusControl}" />
    <Setter Property="Padding" Value="12,10" />
  </Style>
  <Style x:Key="Chip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ChipExtraBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusChip}" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>
  <Style x:Key="OutlineChip" TargetType="Border" BasedOn="{StaticResource Chip}">
    <Setter Property="Background" Value="{StaticResource ClearBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
  </Style>
  <Style x:Key="StatChip" TargetType="Border">
    <Setter Property="Background" Value="{StaticResource ChipExtraBrush}" />
    <Setter Property="CornerRadius" Value="{StaticResource RadiusCard}" />
    <Setter Property="Padding" Value="14,10" />
  </Style>
  <Style x:Key="StepBadge" TargetType="Border">
    <Setter Property="Width" Value="22" />
    <Setter Property="Height" Value="22" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="Background" Value="{StaticResource CardAltBrush}" />
    <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
    <Setter Property="BorderThickness" Value="{StaticResource Hairline}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="StepBadgeText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeEyebrow}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="HairlineRule" TargetType="Border">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>
  <Style x:Key="{x:Type Separator}" TargetType="{x:Type Separator}">
    <Setter Property="Background" Value="{StaticResource BorderBrush}" />
    <Setter Property="Height" Value="1" />
    <Setter Property="Margin" Value="0,8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Separator}">
          <Border Background="{TemplateBinding Background}" Height="1" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Fields that are not plain text boxes. -->
  <Style x:Key="CompactFieldBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource FieldBox}">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Padding" Value="10,6" />
  </Style>

  <!-- Search field with a leading icon. Tag holds the placeholder. -->
  <Style x:Key="SearchBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource FieldBox}">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <controls:FieldRing IsActive="{TemplateBinding IsKeyboardFocused}" Background="{TemplateBinding Background}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Path Width="15" Height="15" Style="{StaticResource LineIcon}" Data="{StaticResource IconSearch}" Stroke="{StaticResource MutedBrush}" HorizontalAlignment="Center" />
              <ScrollViewer Name="PART_ContentHost" Grid.Column="1" Margin="0,0,10,0" VerticalAlignment="Center" Focusable="False" />
              <TextBlock Name="Hint" Grid.Column="1" Text="{TemplateBinding Tag}" Margin="2,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
            </Grid>
          </controls:FieldRing>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value="" />
                <Condition Property="IsKeyboardFocused" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
            </MultiTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="KeyPasteBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeMono}" />
    <Setter Property="IsUndoEnabled" Value="False" />
    <Setter Property="SpellCheck.IsEnabled" Value="False" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <controls:FieldRing IsActive="{TemplateBinding IsKeyboardFocused}" Background="{TemplateBinding Background}">
            <Grid>
              <ScrollViewer x:Name="PART_ContentHost" Margin="0,2" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Auto" />
              <TextBlock x:Name="Hint" Text="{TemplateBinding Tag}" Foreground="{StaticResource MutedBrush}" Margin="14,10" VerticalAlignment="Top" IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
          </controls:FieldRing>
          <ControlTemplate.Triggers>
            <MultiTrigger>
              <MultiTrigger.Conditions>
                <Condition Property="Text" Value="" />
                <Condition Property="IsKeyboardFocused" Value="False" />
              </MultiTrigger.Conditions>
              <Setter TargetName="Hint" Property="Visibility" Value="Visible" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Bare inputs placed inside a FieldRing (Decrypt passphrase, expected-hash box). -->
  <Style x:Key="BareInput" TargetType="{x:Type Control}">
    <Setter Property="Background" Value="{StaticResource ClearBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Padding" Value="10,0" />
  </Style>
  <Style x:Key="BarePasswordBox" TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource BareInput}">
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type PasswordBox}">
          <Border Background="{StaticResource ClearBrush}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
            <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type PasswordBox}" TargetType="{x:Type PasswordBox}" BasedOn="{StaticResource BarePasswordBox}">
    <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type PasswordBox}">
          <controls:FieldRing IsActive="{TemplateBinding IsKeyboardFocused}" Background="{StaticResource SurfaceBrush}">
            <Border Background="{StaticResource ClearBrush}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
              <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
            </Border>
          </controls:FieldRing>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <!-- Bare text box for the same field chrome (passphrase reveal, expected-hash paste). -->
  <Style x:Key="BareTextBox" TargetType="{x:Type TextBox}" BasedOn="{StaticResource BareInput}">
    <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    <Setter Property="SelectionBrush" Value="{StaticResource SelectionBrush}" />
    <Setter Property="FontFamily" Value="{StaticResource SansFont}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Background="{StaticResource ClearBrush}" Padding="{TemplateBinding Control.Padding}" SnapsToDevicePixels="True">
            <ScrollViewer Name="PART_ContentHost" VerticalAlignment="Center" Focusable="False" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FieldChrome" TargetType="controls:FieldRing" BasedOn="{StaticResource {x:Type controls:FieldRing}}">
    <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    <Setter Property="Height" Value="{StaticResource ControlHeight}" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
  </Style>

  <Style TargetType="CheckBox">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="{StaticResource ClearBrush}">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border x:Name="Box" Width="18" Height="18" CornerRadius="5" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource FieldBorderBrush}" BorderThickness="1" VerticalAlignment="Top" Margin="0,1,0,0">
              <Path x:Name="Tick" Width="11" Height="11" Style="{StaticResource LineIcon}" StrokeThickness="2" Data="{StaticResource IconCheck}" Stroke="{StaticResource PrimaryInkBrush}" Visibility="Collapsed" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Box" Property="Background" Value="{StaticResource PrimaryFillBrush}" />
              <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource PrimaryFillBrush}" />
              <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Lists. A record list row: hairline below, hover fill, selected panel with an accent edge. -->
  <Style x:Key="{x:Type ListBox}" TargetType="{x:Type ListBox}">
    <Setter Property="Background" Value="{StaticResource ClearBrush}" />
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
    <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
    <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBox}">
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
            <ScrollViewer Focusable="False" Padding="0">
              <ItemsPresenter />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ListBoxItem}" TargetType="{x:Type ListBoxItem}">
    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
    <Setter Property="Background" Value="{StaticResource ClearBrush}" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="Margin" Value="0,0,0,2" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ListBoxItem}">
          <Border Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{StaticResource ClearBrush}" BorderThickness="1" CornerRadius="{StaticResource RadiusControl}" Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" TextElement.Foreground="{TemplateBinding Foreground}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource ZoneHoverBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Bd" Property="Background" Value="{StaticResource CardAltBrush}" />
              <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource LineBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Tabs, drawn as the site's nav links with a 2px underline on the current tab. -->
  <Style x:Key="{x:Type TabControl}" TargetType="{x:Type TabControl}">
    <Setter Property="Background" Value="{StaticResource ClearBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0,12,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabControl}">
          <DockPanel>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}" BorderThickness="{StaticResource HairlineBottom}">
              <TabPanel IsItemsHost="True" />
            </Border>
            <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
          </DockPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type TabItem}" TargetType="{x:Type TabItem}">
    <Setter Property="Foreground" Value="{StaticResource SecondaryBrush}" />
    <Setter Property="FontSize" Value="{StaticResource FontSizeSmall}" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="FocusVisualStyle" Value="{StaticResource FocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
          <Grid Margin="0,0,20,0" Background="{StaticResource ClearBrush}">
            <ContentPresenter ContentSource="Header" Margin="0,8,0,10" TextElement.Foreground="{TemplateBinding Foreground}" />
            <Border Name="Rule" Height="2" VerticalAlignment="Bottom" Background="{StaticResource ClearBrush}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
              <Setter TargetName="Rule" Property="Background" Value="{StaticResource TextBrush}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="{x:Type Hyperlink}" TargetType="{x:Type Hyperlink}">
    <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
    <Setter Property="TextDecorations" Value="{x:Null}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Foreground" Value="{StaticResource AccentHoverBrush}" />
        <Setter Property="TextDecorations" Value="Underline" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Page header: mono eyebrow, gradient title, one-line lead, actions on the right. -->
  <Style TargetType="{x:Type controls:DeviPageHeader}">
    <Setter Property="Margin" Value="0,0,0,16" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type controls:DeviPageHeader}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Bottom" Margin="0,0,24,0">
              <TextBlock Text="{TemplateBinding Eyebrow}" Style="{StaticResource Text.Eyebrow}" Margin="0,0,0,6" />
              <TextBlock Text="{TemplateBinding Title}" Style="{StaticResource Text.Display}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <TextBlock Text="{TemplateBinding Lead}" Style="{StaticResource Text.Secondary}" Margin="0,4,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
            </StackPanel>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Bottom" Margin="0,0,0,2" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
