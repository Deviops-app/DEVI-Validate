<?xml version="1.0" encoding="utf-8"?>
<!--
  DEVI line icons. 24 by 24 outline geometry, drawn with a 1.5 stroke in the current text
  color. Drawn as geometry, not font glyphs, so they render the same on every Windows build.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Geometry x:Key="IconFile">M14,3 L6,3 C5.4,3 5,3.4 5,4 L5,20 C5,20.6 5.4,21 6,21 L18,21 C18.6,21 19,20.6 19,20 L19,8 Z M14,3 L14,8 L19,8</Geometry>
  <Geometry x:Key="IconFolder">M3,6 C3,5.4 3.4,5 4,5 L9,5 L11,7 L20,7 C20.6,7 21,7.4 21,8 L21,18 C21,18.6 20.6,19 20,19 L4,19 C3.4,19 3,18.6 3,18 Z</Geometry>
  <Geometry x:Key="IconList">M14,3 L6,3 C5.4,3 5,3.4 5,4 L5,20 C5,20.6 5.4,21 6,21 L18,21 C18.6,21 19,20.6 19,20 L19,8 Z M14,3 L14,8 L19,8 M8.5,12.5 L15.5,12.5 M8.5,15.5 L15.5,15.5 M8.5,18 L12.5,18</Geometry>
  <Geometry x:Key="IconLock">M6,11 L18,11 C18.6,11 19,11.4 19,12 L19,20 C19,20.6 18.6,21 18,21 L6,21 C5.4,21 5,20.6 5,20 L5,12 C5,11.4 5.4,11 6,11 Z M8,11 L8,7.5 C8,5.3 9.8,3.5 12,3.5 C14.2,3.5 16,5.3 16,7.5 L16,11</Geometry>
  <Geometry x:Key="IconSearch">M10.5,4 A6.5,6.5 0 1 1 10.49,4 Z M15.2,15.2 L20,20</Geometry>
  <Geometry x:Key="IconExternal">M14,4 L20,4 L20,10 M20,4 L11,13 M18,14 L18,19 C18,19.6 17.6,20 17,20 L5,20 C4.4,20 4,19.6 4,19 L4,7 C4,6.4 4.4,6 5,6 L10,6</Geometry>
  <Geometry x:Key="IconCheck">M5,12.5 L10,17.5 L19,7</Geometry>
  <Geometry x:Key="IconShield">M12,3 L19,6 L19,11.5 C19,16 16,19.5 12,21 C8,19.5 5,16 5,11.5 L5,6 Z M9,12 L11.2,14.2 L15.5,9.8</Geometry>
  <Geometry x:Key="IconChevronDown">M6,9 L12,15 L18,9</Geometry>
  <Geometry x:Key="IconChevronRight">M9,6 L15,12 L9,18</Geometry>
  <!-- Header icons: help (question mark), settings (gear), and more (three dots). -->
  <Geometry x:Key="IconHelp">M9.25,9.25 C9.25,7.6 10.5,6.5 12,6.5 C13.55,6.5 14.75,7.55 14.75,9 C14.75,10.35 13.85,10.95 12.95,11.55 C12.35,11.95 12,12.45 12,13.35 L12,13.9 M12,17.25 L12,17.35</Geometry>
  <Geometry x:Key="IconSettings">M18.69,9.95 L21.03,10.24 L21.03,13.76 L18.69,14.05 L18.18,15.29 L19.63,17.14 L17.14,19.63 L15.29,18.18 L14.05,18.69 L13.76,21.03 L10.24,21.03 L9.95,18.69 L8.71,18.18 L6.86,19.63 L4.37,17.14 L5.82,15.29 L5.31,14.05 L2.97,13.76 L2.97,10.24 L5.31,9.95 L5.82,8.71 L4.37,6.86 L6.86,4.37 L8.71,5.82 L9.95,5.31 L10.24,2.97 L13.76,2.97 L14.05,5.31 L15.29,5.82 L17.14,4.37 L19.63,6.86 L18.18,8.71 Z M15,12 A3,3 0 1 1 15,11.99 Z</Geometry>
  <Geometry x:Key="IconMore">M6,12 L6.01,12 M12,12 L12.01,12 M18,12 L18.01,12</Geometry>
  <Geometry x:Key="IconCaptionMinimize">M0,5 L10,5</Geometry>
  <Geometry x:Key="IconCaptionMaximize">M0.5,0.5 L9.5,0.5 L9.5,9.5 L0.5,9.5 Z</Geometry>
  <Geometry x:Key="IconCaptionRestore">M2.5,2.5 L9.5,2.5 L9.5,9.5 L2.5,9.5 Z M0.5,7.5 L0.5,0.5 L7.5,0.5</Geometry>
  <Geometry x:Key="IconCaptionClose">M0.5,0.5 L9.5,9.5 M9.5,0.5 L0.5,9.5</Geometry>

  <!-- A line icon sized for body text. Set Data to one of the geometries above. -->
  <Style x:Key="LineIcon" TargetType="Path">
    <Setter Property="Width" Value="20" />
    <Setter Property="Height" Value="20" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="StrokeThickness" Value="1.5" />
    <Setter Property="StrokeLineJoin" Value="Round" />
    <Setter Property="StrokeStartLineCap" Value="Round" />
    <Setter Property="StrokeEndLineCap" Value="Round" />
    <Setter Property="SnapsToDevicePixels" Value="False" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style x:Key="LineIconLarge" TargetType="Path" BasedOn="{StaticResource LineIcon}">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
  </Style>
</ResourceDictionary>
